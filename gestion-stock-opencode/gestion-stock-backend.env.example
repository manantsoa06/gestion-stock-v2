# À copier vers gestion-stock-backend/.env — ne jamais committer le vrai .env

PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_stock
DB_USER=app_user
DB_PASSWORD=change_me

# JWT
JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_32_caracteres_minimum
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Compte admin initial (utilisé uniquement par le script de seed, une fois)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_before_first_run
